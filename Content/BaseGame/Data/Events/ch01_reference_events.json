{
  "schemaVersion": 1,
  "definitions": [
    {
      "id": "base:event_ch01_ref_opening",
      "type": "contentEvent",
      "name": "开局·杂役晨点",
      "body": "青云宗外围资源点。锣声未绝，主管已在路上。你们三人仍是杂役弟子：白天交差，夜里才有一点属于自己的缝隙。\n\n【测试三任务】巡视农田 → 三人分派 → 树林伐木。",
      "trigger": "manual",
      "once": true,
      "conditions": [],
      "choices": [
        {
          "id": "accept_yoke",
          "text": "知道了，开始巡视",
          "outcomes": [
            { "kind": "setFlag", "id": "event:ch01_ref_opening_seen" },
            { "kind": "setFlag", "id": "story:ch01_phase_awaken" }
          ]
        }
      ]
    },
    {
      "id": "base:event_ch01_ref_miner_grumble",
      "type": "contentEvent",
      "name": "矿洞·杂役闲话",
      "body": "矿洞口有人抱怨配额又加了。三人分派之后，这类闲话才会冒出来。",
      "trigger": "onExplore",
      "locationId": "base:loc_ref_mine",
      "once": true,
      "conditions": [
        { "kind": "storyFlag", "id": "quest:ch01_ref_dispatch_done" }
      ],
      "choices": [
        {
          "id": "listen",
          "text": "听几句再走",
          "outcomes": [
            { "kind": "setFlag", "id": "event:ch01_ref_miner_met" }
          ]
        },
        {
          "id": "pass",
          "text": "不想惹事",
          "outcomes": [
            { "kind": "setFlag", "id": "event:ch01_ref_miner_passed" }
          ]
        }
      ]
    },
    {
      "id": "base:event_ch01_ref_supervisor_talk",
      "type": "contentEvent",
      "name": "杂役主管·训话",
      "body": "「今日的配额，酉时前交齐。偷懒的，别怪我不讲情面。」\n\n你可以应声领命；若对训话不语，主管可能当场加罚。",
      "trigger": "onTalk",
      "npcDefinitionId": "base:character_ch01_ref_supervisor",
      "once": false,
      "conditions": [
        { "kind": "missingFlag", "id": "quest:ch01_ref_supervisor_penalty_assigned" }
      ],
      "choices": [
        {
          "id": "ack",
          "text": "遵命。",
          "outcomes": [
            { "kind": "setFlag", "id": "event:ch01_ref_supervisor_ack" }
          ]
        },
        {
          "id": "silent",
          "text": "……（不语）",
          "outcomes": [
            { "kind": "setFlag", "id": "event:ch01_ref_supervisor_silent" },
            { "kind": "setFlag", "id": "quest:ch01_ref_supervisor_penalty_assigned" },
            {
              "kind": "relationDelta",
              "fromDefinitionId": "base:character_ch01_ref_supervisor",
              "toDefinitionIds": ["@party"],
              "amount": -12
            },
            { "kind": "startQuest", "id": "base:quest_ch01_ref_supervisor_herb_penalty" }
          ]
        }
      ]
    },
    {
      "id": "base:event_ch01_ref_supervisor_talk_hurry",
      "type": "contentEvent",
      "name": "杂役主管·催促",
      "body": "「还不快去采灵药？罚单已经开了——两日内交齐，别指望我再提醒第二遍。」",
      "trigger": "onTalk",
      "npcDefinitionId": "base:character_ch01_ref_supervisor",
      "once": false,
      "conditions": [
        { "kind": "hasFlag", "id": "quest:ch01_ref_supervisor_penalty_assigned" },
        { "kind": "missingFlag", "id": "quest:ch01_ref_supervisor_penalty_done" }
      ],
      "choices": [
        {
          "id": "go",
          "text": "……这就去。",
          "outcomes": [
            { "kind": "setFlag", "id": "event:ch01_ref_supervisor_hurry_ack" }
          ]
        },
        {
          "id": "bow",
          "text": "是……",
          "outcomes": []
        }
      ]
    }
  ]
}

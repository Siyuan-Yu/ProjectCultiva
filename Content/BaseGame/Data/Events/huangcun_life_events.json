      "steps": [
        {
          "id": "look",
          "speakerRef": "",
          "text": "粗树皮上留下新旧交错的斧痕。有人在这里讨生活，也有人只是从这里经过。\n\n一条小径朝灵泉的方向延伸。村里的阿木常来此处；想知道山里的事，可以先问走过这些路的人。",
          "outcomes": [
            {
              "kind": "setFlag",
              "id": "story:huangcun_forest_seen"
            }
          ],
          "choices": [
            {
              "id": "leave",
              "text": "记下，再看看。",
              "conditions": [],
              "outcomes": [],
              "nextStepId": "",
              "unavailableMode": "disabled",
              "requirementText": ""
            }
          ]
        }
      ]
    },
    {
      "id": "base:event_huangcun_mine",
      "type": "contentEvent",
      "name": "矿洞·尘土与旧字",
      "trigger": "onExplore",

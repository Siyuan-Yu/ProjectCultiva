              "conditions": [],
              "outcomes": [],
              "nextStepId": "",
              "unavailableMode": "disabled",
              "requirementText": ""
            }
          ]
        }
      ]
    },
    {
      "id": "base:event_huangcun_cave_chamber",
      "type": "contentEvent",
      "name": "洞府·旧居并不等于无主之物",
      "trigger": "onExplore",

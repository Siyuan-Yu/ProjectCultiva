        {
          "id": "talk",
          "speakerRef": "@target",
          "text": "「出去走一趟，和把余生都交给谁，是两码事。」对方把活计放下，「想找人同行就说清去哪；想长期相处，总要先知道彼此愿不愿意。」\n\n普通对话不会自动招募、加入势力或强制编队。实际招募与任务同行使用各自的交互入口和条件。",
          "outcomes": [
            {
              "kind": "setFlag",
              "id": "story:huangcun_neighbor_met"
            }
          ],
          "choices": [
            {
              "id": "leave",
              "text": "先各忙各的，有事再谈。",
              "conditions": [],
              "outcomes": [],
              "nextStepId": "",
              "unavailableMode": "disabled",
              "requirementText": ""
            }
          ]
        }
      ]
    },
    {
      "id": "base:event_huangcun_forest",
      "type": "contentEvent",
      "name": "树林·被踩实的小路",
      "trigger": "onExplore",
      "locationId": "base:loc_ref_forest",
      "once": true,

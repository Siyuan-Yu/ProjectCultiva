    {
      "id": "base:event_huangcun_medicine_offer",
      "type": "contentEvent",
      "name": "阿杏·把药备上",
      "trigger": "onTalk",
      "npcDefinitionId": "base:character_ch01_ref_herb_c",
      "priority": 40,
      "topicText": "阿杏·把药备上",
      "once": false,
      "onceScope": "global",
      "conditions": [
        {
          "kind": "hasFlag",
          "id": "story:huangcun_production"
        },
        {
          "kind": "questOfferableFromTarget",
          "id": "base:quest_huangcun_medicine"
        }
      ],
      "entryStepId": "offer",
      "steps": [
        {
          "id": "offer",
          "speakerRef": "@target",
          "text": "阿杏把晒干的药叶分成小堆：「床边用的药不能等有人倒下才去找。你若能匀来两份灵药，我这里还有三份粮食可以换给你。」\n\n「不是急令，先顾好你自己。药交给我本人，免得混进别的筐。」",
          "outcomes": [
            {
              "kind": "setFlag",
              "id": "story:huangcun_neighbor_met"
            }
          ],
          "choices": [
            {
              "id": "accept",
              "text": "我愿意帮这次忙。",
              "conditions": [],
              "outcomes": [
                {
                  "kind": "acceptQuestFromTarget",
                  "id": "base:quest_huangcun_medicine"
                }
              ],
              "nextStepId": "",
              "unavailableMode": "disabled",
              "requirementText": ""
            },
            {
              "id": "advice",
              "text": "先聊聊附近的事。",
              "conditions": [],
              "outcomes": [],
              "nextStepId": "advice",
              "unavailableMode": "disabled",
              "requirementText": ""
            },
            {
              "id": "later",
              "text": "我先不答应，改日再说。",
              "conditions": [],
              "outcomes": [],
              "nextStepId": "",
              "unavailableMode": "disabled",
              "requirementText": ""
            }
          ]
        },
        {
          "id": "advice",
          "speakerRef": "@target",
          "text": "「伤了就找医者和医疗床，不要只盯着那一点血。」阿杏说，「药效、卧床恢复和能否起身，各有各的条件。光答应帮忙，不会让床上的人立刻痊愈。」",
          "outcomes": [],
          "choices": [
            {
              "id": "back",
              "text": "说回刚才的事。",
              "conditions": [],
              "outcomes": [],
              "nextStepId": "offer",
              "unavailableMode": "disabled",
              "requirementText": ""
            },
            {
              "id": "leave",
              "text": "记下了，多谢。",
              "conditions": [],
              "outcomes": [],
              "nextStepId": "",
              "unavailableMode": "disabled",
              "requirementText": ""
            }
          ]
        }
      ]
    },

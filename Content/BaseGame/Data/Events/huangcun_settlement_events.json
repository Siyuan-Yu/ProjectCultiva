      "priority": 40,
      "topicText": "阿兰·药圃支架·托付",
      "once": false,
      "conditions": [
        {
          "kind": "hasFlag",
          "id": "story:huangcun_production"
        },
        {
          "kind": "questOfferableFromTarget",

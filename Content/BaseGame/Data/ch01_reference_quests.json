      "rewards": [
        { "kind": "setFlag", "id": "quest:ch01_ref_manual_done" },
        { "kind": "setFlag", "id": "story:ch01_phase_manual" },
        { "kind": "grantProgress", "amount": 20 }
      ],
      "failConditions": [],
      "failResults": []
    },
    {
      "id": "base:quest_ch01_ref_night_cultivate",
      "type": "quest",
      "name": "暗修·夜缝入定",
      "description": "【秘密修炼】持诀后回到洞府站稳。宜入夜再入定；白天更易被察觉。",
      "autoOffer": true,
      "offerConditions": [
        { "kind": "storyFlag", "id": "quest:ch01_ref_manual_done" }
      ],
      "completeConditions": [

      "rewards": [
        { "kind": "setFlag", "id": "quest:ch01_ref_wood_done" },
        { "kind": "setFlag", "id": "story:ch01_phase_quota_felt" }
      ],
      "failConditions": [],
      "failResults": []
    },
    {

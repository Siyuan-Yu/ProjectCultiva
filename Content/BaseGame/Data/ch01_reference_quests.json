{
  "schemaVersion": 1,
  "definitions": [
    {
      "id": "base:quest_ch01_ref_inspect_yard",
      "type": "quest",
      "name": "日课·巡视杂役区",
      "description": "【Day0】你已在农田杂役区。走开再走回农田（首次入区会自动勘察），完成巡视。左键可选中甲乙丙三人；指令默认完全由你安排。",
      "autoOffer": true,
      "offerConditions": [],
      "completeConditions": [
        { "kind": "exploredLocation", "id": "base:loc_ref_labor_yard" }
      ],
      "rewards": [
        { "kind": "setFlag", "id": "quest:ch01_ref_yard_done" },
        { "kind": "setFlag", "id": "story:ch01_phase_labor_seen" }
      ],
      "failConditions": [],
      "failResults": []
    },
    {
      "id": "base:quest_ch01_ref_dispatch_party",
      "type": "quest",
      "name": "调度·三人分派",
      "description": "【自由安排】框选或分头点选三人。可一人去麦田交互收粮、一人去树林伐木、一人去药田采药——也可同一人连跑三处。凑齐：粗粮≥1、粗木≥1、灵药≥1。",
      "autoOffer": true,
      "offerConditions": [
        { "kind": "storyFlag", "id": "quest:ch01_ref_yard_done" }
      ],
      "completeConditions": [
        { "kind": "stockAtLeast", "id": "base:resource_grain", "amount": 1 },
        { "kind": "stockAtLeast", "id": "base:resource_rough_wood", "amount": 1 },
        { "kind": "stockAtLeast", "id": "base:resource_spirit_herb", "amount": 1 }
      ],
      "rewards": [
        { "kind": "setFlag", "id": "quest:ch01_ref_dispatch_done" },
        { "kind": "setFlag", "id": "story:ch01_phase_party_free" }
      ],
      "failConditions": [],
      "failResults": []
    },
    {
      "id": "base:quest_ch01_ref_gather_wood",
      "type": "quest",
      "name": "日课·伐木交差",
      "description": "【杂役任务】主管点名要木料。点「交互」再左键树林（或走到后交互），使粗木库存≥2。",
      "autoOffer": true,
      "offerConditions": [
        { "kind": "storyFlag", "id": "quest:ch01_ref_dispatch_done" }
      ],
      "completeConditions": [
        { "kind": "stockAtLeast", "id": "base:resource_rough_wood", "amount": 2 }
      ],
      "rewards": [
        { "kind": "setFlag", "id": "quest:ch01_ref_wood_done" },
        { "kind": "setFlag", "id": "story:ch01_phase_quota_felt" }
      ],
      "failConditions": [],
      "failResults": []
    },
    {
      "id": "base:quest_ch01_ref_gather_herb",
      "type": "quest",
      "name": "日课·药田采摘",
      "description": "【杂役任务】再补灵药。点「交互」再左键药田，使灵药库存≥2。白天交差，夜里才挤得出缝隙。",
      "autoOffer": true,
      "offerConditions": [
        { "kind": "storyFlag", "id": "quest:ch01_ref_wood_done" }
      ],
      "completeConditions": [
        { "kind": "stockAtLeast", "id": "base:resource_spirit_herb", "amount": 2 }
      ],
      "rewards": [
        { "kind": "setFlag", "id": "quest:ch01_ref_herb_done" },
        { "kind": "setFlag", "id": "story:ch01_phase_herb_done" }
      ],
      "failConditions": [],
      "failResults": []
    },
    {
      "id": "base:quest_ch01_ref_spirit_sense",
      "type": "quest",
      "name": "神识·察觉异样",
      "description": "【探索发现】走到「灵泉」（首次入区会勘察并触发异响）。听完选项即完成。矿洞可顺路听听怨气，非必做。",
      "autoOffer": true,
      "offerConditions": [
        { "kind": "storyFlag", "id": "quest:ch01_ref_herb_done" }
      ],
      "completeConditions": [
        { "kind": "storyFlag", "id": "story:ch01_phase_spirit_sense" }
      ],
      "rewards": [
        { "kind": "setFlag", "id": "quest:ch01_ref_sense_done" }
      ],
      "failConditions": [],
      "failResults": []
    },
    {
      "id": "base:quest_ch01_ref_meet_elder",
      "type": "quest",
      "name": "机缘·砍柴老人",
      "description": "【探索发现】再入树林抵达，会遇砍柴老人。愿闻其详可获洞府方位；也可去道路枢纽再点探索，向行商打听（替代线）。",
      "autoOffer": true,
      "offerConditions": [
        { "kind": "storyFlag", "id": "quest:ch01_ref_sense_done" }
      ],
      "completeConditions": [
        { "kind": "storyFlag", "id": "story:ch01_phase_npc_chance" }
      ],
      "rewards": [
        { "kind": "setFlag", "id": "quest:ch01_ref_elder_done" },
        { "kind": "discoverSite", "id": "base:site_abandoned_cave" }
      ],
      "failConditions": [],
      "failResults": []
    },
    {
      "id": "base:quest_ch01_ref_visit_cave",
      "type": "quest",
      "name": "机缘·废弃洞府",
      "description": "【秘密修炼准备】前往废弃洞府并探索。灵气异于田垄，是暗修好地方——也是暴露的风险地。",
      "autoOffer": true,
      "offerConditions": [
        { "kind": "storyFlag", "id": "quest:ch01_ref_elder_done" }
      ],
      "completeConditions": [
        { "kind": "exploredLocation", "id": "base:loc_ref_cave" }
      ],
      "rewards": [
        { "kind": "setFlag", "id": "quest:ch01_ref_cave_done" },
        { "kind": "setFlag", "id": "story:ch01_phase_site_found" },
        { "kind": "grantProgress", "amount": 10 }
      ],
      "failConditions": [],
      "failResults": []
    },
    {
      "id": "base:quest_ch01_ref_first_manual",
      "type": "quest",
      "name": "机缘·第一份功法",
      "description": "【秘密修炼】在洞府点「修炼」入定。尚未得诀时，入定会领悟青云诀。",
      "autoOffer": true,
      "offerConditions": [
        { "kind": "storyFlag", "id": "quest:ch01_ref_cave_done" }
      ],
      "completeConditions": [
        { "kind": "hasManual", "id": "base:cultivation_qingyun_manual" }

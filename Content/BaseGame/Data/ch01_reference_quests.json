      "rewards": [
        { "kind": "setFlag", "id": "quest:ch01_ref_dark_ready" },
        { "kind": "setFlag", "id": "story:ch01_phase_near_qi" },
        { "kind": "grantProgress", "amount": 30 }
      ],
      "failConditions": [],
      "failResults": []
    },
    {
      "id": "base:quest_ch01_ref_breakthrough",
      "type": "quest",
      "name": "突破·第一次炼气",
      "description": "【第一次突破】再入洞府触发「引气入体」，再点修炼入定冲击炼气。同伴可在外活动作掩护。",
      "autoOffer": true,
      "offerConditions": [
        { "kind": "storyFlag", "id": "quest:ch01_ref_dark_ready" }
      ],
      "completeConditions": [
        { "kind": "realmAtLeast", "realm": "QiRefining" }
      ],
      "rewards": [
        { "kind": "setFlag", "id": "quest:ch01_ref_breakthrough_done" },
        { "kind": "setFlag", "id": "story:ch01_phase_qi_refining" }
      ],
      "failConditions": [],
      "failResults": []
    },
    {
      "id": "base:quest_ch01_ref_hide",
      "type": "quest",
      "name": "隐藏·敛息藏修",
      "description": "【隐藏修士】炼气后不可张扬。回房屋区探索，确认敛息与明面劳役如何并行；备好敛息草。",
      "autoOffer": true,
      "offerConditions": [
        { "kind": "storyFlag", "id": "quest:ch01_ref_breakthrough_done" }
      ],
      "completeConditions": [
        { "kind": "storyFlag", "id": "story:ch01_phase_hidden_cultivator" }
      ],
      "rewards": [
        { "kind": "setFlag", "id": "quest:ch01_ref_hide_done" },
        { "kind": "addStock", "id": "base:resource_conceal_grass", "amount": 2 }
      ],
      "failConditions": [],
      "failResults": []
    },
    {
      "id": "base:quest_ch01_ref_epilogue",
      "type": "quest",
      "name": "伏笔·看清辖区",
      "description": "【权力伏笔】你已踏入修仙门槛，却仍戴着杂役身份。回道路枢纽探索，听听行商与守卫背后的制度气味——第一章觉醒弧于此收束。战斗与夺权不在本关。",
      "autoOffer": true,
      "offerConditions": [
        { "kind": "storyFlag", "id": "quest:ch01_ref_hide_done" }
      ],
      "completeConditions": [
        { "kind": "storyFlag", "id": "story:ch01_ref_arc_complete" }
      ],
      "rewards": [
        { "kind": "setFlag", "id": "quest:ch01_ref_epilogue_done" },
        { "kind": "grantProgress", "amount": 5 }
      ],
      "failConditions": [],
      "failResults": []
    }

      "type": "quest",
      "name": "日课·药田采摘",
      "description": "【生存压力】顺带采药。走到药田后点「劳动」／探索，使灵药库存≥2。白天多出力，夜里才挤得出缝隙。",
      "autoOffer": true,
      "offerConditions": [
        { "kind": "storyFlag", "id": "quest:ch01_ref_wood_done" }
      ],
      "completeConditions": [
        { "kind": "stockAtLeast", "id": "base:resource_spirit_herb", "amount": 2 }

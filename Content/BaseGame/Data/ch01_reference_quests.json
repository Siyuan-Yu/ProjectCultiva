    {
      "id": "base:quest_ch01_ref_inspect_yard",
      "type": "quest",
      "name": "日课·巡视杂役区",
      "description": "【劳役入场】你已在农田杂役区。点底栏「探索」或按 F3 勘察此地；或先右键去别处，再走回农田（首次进入会自动勘察）。",
      "autoOffer": true,
      "offerConditions": [],
      "completeConditions": [
        { "kind": "exploredLocation", "id": "base:loc_ref_labor_yard" }
      ],
      "rewards": [
        { "kind": "setFlag", "id": "quest:ch01_ref_yard_done" },
        { "kind": "setFlag", "id": "story:ch01_phase_labor_seen" }
      ],
      "failConditions": [],
      "failResults": []
    },
    {
      "id": "base:quest_ch01_ref_gather_wood",
      "type": "quest",
      "name": "日课·伐木交差",
      "description": "【生存压力】主管要木料。走到「树林」后点底栏「劳动」／F4（或按 W 再左键点树林）；粗木库存≥2 即交差。",
      "autoOffer": true,
      "offerConditions": [
        { "kind": "storyFlag", "id": "quest:ch01_ref_yard_done" }
      ],
      "completeConditions": [
        { "kind": "stockAtLeast", "id": "base:resource_rough_wood", "amount": 2 }

      "entryStepId": "inspect",
      "steps": [
        {
          "id": "inspect",
          "speakerRef": "",
          "text": "苔痕盖住了大半字。还能辨出“泉东”“敛息”几字，落款早已剥尽。\n\n这不是一部能直接学会的功法，只是前人走过这里的痕迹。你记下灵泉东侧可能藏有入口，打算靠近后用神识勘查。",
          "outcomes": [],
          "choices": [
            {
              "id": "take",
              "text": "记下线索，继续赶路。",
              "conditions": [],
              "outcomes": [
                {
                  "kind": "setFlag",
                  "id": "story:huangcun_cave_hint"
                },
                {
                  "kind": "setFlag",
                  "id": "story:huangcun_waystone_resolved"
                },
                {
                  "kind": "resolveCurrentOpportunity"
                }
              ],
              "nextStepId": ""
            },
            {
              "id": "leave",
              "text": "暂时不动，继续赶路。",
              "conditions": [],
              "outcomes": [],
              "nextStepId": ""
            }
          ]
        }
      ]
    },
    {

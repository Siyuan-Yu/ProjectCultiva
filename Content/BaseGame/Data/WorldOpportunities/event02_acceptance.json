    {
      "id": "base:event_event02_wounded_cultivator_talk",
      "type": "contentEvent",
      "name": "EVENT-02 受伤散修交谈",
      "trigger": "onTalk",
      "npcTags": [
        "cultivator",
        "wounded"
      ],
      "worldOpportunityId": "base:world_opportunity_event02_wounded_cultivator",
      "priority": 50,
      "topicText": "询问伤势",
      "once": false,
      "onceScope": "global",
      "conditions": [
        {
          "kind": "questOfferableFromTarget",
          "id": "base:quest_event02_wounded_cultivator_herb"
        }
      ],
      "entryStepId": "start",
      "steps": [
        {
          "id": "start",
          "speakerRef": "@target",
          "text": "「只是旧伤复发，一时难以调息。若道友方便，可否替我寻些灵药？」",
          "outcomes": [],
          "choices": [
            {
              "id": "accept",
              "text": "我帮你去找。",
              "conditions": [],
              "outcomes": [
                {
                  "kind": "acceptQuestFromTarget",
                  "id": "base:quest_event02_wounded_cultivator_herb"
                }
              ],
              "nextStepId": "player_accept",
              "unavailableMode": "disabled",
              "requirementText": ""
            },
            {
              "id": "leave",
              "text": "我还有别的事。",
              "conditions": [],
              "outcomes": [],
              "nextStepId": "",
              "unavailableMode": "disabled",
              "requirementText": ""
            }
          ]
        },
        {
          "id": "player_accept",
          "speakerRef": "@actor",
          "text": "好，我帮你找。",
          "nextStepId": "thanks",
          "outcomes": [],
          "choices": []
        },
        {
          "id": "thanks",
          "speakerRef": "@target",
          "text": "「多谢道友。」",
          "outcomes": [],
          "choices": []
        }
      ]
    },
    {
      "id": "base:event_event02_wounded_cultivator_herb_active",
      "type": "contentEvent",
      "name": "EVENT-02 受伤散修灵药交付",
      "trigger": "onTalk",
      "npcTags": [
        "cultivator",
        "wounded"
      ],
      "worldOpportunityId": "base:world_opportunity_event02_wounded_cultivator",
      "priority": 60,
      "topicText": "交付灵药",
      "once": false,
      "onceScope": "global",
      "conditions": [
        {
          "kind": "questActiveFromTarget",
          "id": "base:quest_event02_wounded_cultivator_herb"
        }
      ],
      "entryStepId": "start",
      "steps": [
        {
          "id": "start",
          "speakerRef": "@target",
          "text": "「道友可寻到合用的灵药了？」",
          "outcomes": [],
          "choices": [
            {
              "id": "hand_in",
              "text": "把灵药交给他。",
              "conditions": [
                {
                  "kind": "questDeliveryAvailableFromTarget",
                  "id": "base:quest_event02_wounded_cultivator_herb"
                }
              ],
              "outcomes": [
                {
                  "kind": "deliverQuestToTarget",
                  "id": "base:quest_event02_wounded_cultivator_herb"
                },
                {
                  "kind": "relationDelta",
                  "fromDefinitionId": "@target",
                  "toDefinitionIds": [
                    "@actor"
                  ],
                  "amount": 1
                }
              ],
              "nextStepId": "player_hand_in",
              "unavailableMode": "disabled",
              "requirementText": "需要灵药 ×1"
            },
            {
              "id": "not_yet",
              "text": "我还没找到。",
              "conditions": [],
              "outcomes": [],
              "nextStepId": "",
              "unavailableMode": "disabled",
              "requirementText": ""
            }
          ]
        },
        {
          "id": "player_hand_in",
          "speakerRef": "@actor",
          "text": "这份灵药你先拿去用。",
          "nextStepId": "thanks",
          "outcomes": [],
          "choices": []
        },
        {
          "id": "thanks",
          "speakerRef": "@target",
          "text": "「多谢道友，此情我记下了。」",
          "outcomes": [],
          "choices": []
        }
      ]

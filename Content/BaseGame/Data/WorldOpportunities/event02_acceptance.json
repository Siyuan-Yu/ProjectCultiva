      "onceScope": "global",
      "conditions": [
        { "kind": "questActiveFromTarget", "id": "base:quest_event02_wounded_cultivator_herb" }
      ],
      "entryStepId": "start",
      "steps": [
        {
          "id": "start",
          "speakerRef": "@target",
          "text": "「道友可寻到合用的灵药了？」",
          "outcomes": [],
          "choices": [
            {
              "id": "hand_in",
              "text": "把灵药交给他。",
              "conditions": [
                { "kind": "questDeliveryAvailableFromTarget", "id": "base:quest_event02_wounded_cultivator_herb" }
              ],
              "outcomes": [
                { "kind": "deliverQuestToTarget", "id": "base:quest_event02_wounded_cultivator_herb" },
                { "kind": "relationDelta", "fromDefinitionId": "@target", "toDefinitionIds": ["@actor"], "amount": 1 }
              ],
              "nextStepId": "player_hand_in",
              "unavailableMode": "disabled",
              "requirementText": "需要灵药 ×1"
            },
            { "id": "not_yet", "text": "我还没找到。", "conditions": [], "outcomes": [], "nextStepId": "", "unavailableMode": "disabled", "requirementText": "" }
          ]
        },
        { "id": "player_hand_in", "speakerRef": "@actor", "text": "这份灵药你先拿去用。", "nextStepId": "thanks", "outcomes": [], "choices": [] },
        { "id": "thanks", "speakerRef": "@target", "text": "「多谢道友，此情我记下了。」", "outcomes": [], "choices": [] }
      ]
    },
    {

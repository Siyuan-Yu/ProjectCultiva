<Window x:Class="WorldGraphEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XianXia · 大世界图编辑器（WorldGraph）" Height="820" Width="1280"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
        <Button Content="打开包…" Width="90" Margin="0,0,8,0" Click="OpenPackage_Click"/>
        <TextBlock Text="worldGraph" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox x:Name="GraphCombo" Width="320" SelectionChanged="GraphCombo_SelectionChanged"/>
        <Button Content="新建图…" Width="80" Margin="8,0,0,0" Click="NewGraph_Click"/>
        <Button Content="保存到磁盘" Width="100" Margin="12,0,0,0" Click="Save_Click"/>
        <TextBlock x:Name="RootText" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
        <TextBlock Text="name" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBox x:Name="NameBox" Width="200" Margin="0,0,12,0"/>
        <TextBlock Text="startNodeId" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBox x:Name="StartBox" Width="260"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Button Content="+ 节点" Width="80" Margin="0,0,8,0" Click="AddNode_Click"/>
        <Button Content="删除选中节点" Width="110" Margin="0,0,16,0" Click="DeleteNode_Click"/>
        <Button Content="+ 道路" Width="80" Margin="0,0,8,0" Click="AddRoute_Click"/>
        <Button Content="删除选中道路" Width="110" Click="DeleteRoute_Click"/>
      </StackPanel>
    </StackPanel>
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0"
               Text="节点＝城镇／关隘等；道路可填 traversalRequirements（如 hasFlag:permit:xxx）"/>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="1.2*"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <DataGrid x:Name="NodeGrid" Grid.Row="0" AutoGenerateColumns="False" CanUserAddRows="False"
                HeadersVisibility="Column" SelectionMode="Single">
        <DataGrid.Columns>
          <DataGridTextColumn Header="id" Binding="{Binding Id}" Width="180"/>
          <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="100"/>
          <DataGridTextColumn Header="kind" Binding="{Binding Kind}" Width="90"/>
          <DataGridTextColumn Header="localMapId" Binding="{Binding LocalMapId}" Width="200"/>
          <DataGridTextColumn Header="worldX" Binding="{Binding WorldX}" Width="70"/>
          <DataGridTextColumn Header="worldY" Binding="{Binding WorldY}" Width="70"/>
          <DataGridTextColumn Header="ownerId" Binding="{Binding OwnerId}" Width="120"/>
          <DataGridTextColumn Header="state" Binding="{Binding State}" Width="80"/>
          <DataGridTextColumn Header="tags" Binding="{Binding Tags}" Width="140"/>
        </DataGrid.Columns>
      </DataGrid>
      <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch"/>
      <DataGrid x:Name="RouteGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                HeadersVisibility="Column" SelectionMode="Single">
        <DataGrid.Columns>
          <DataGridTextColumn Header="id" Binding="{Binding Id}" Width="200"/>
          <DataGridTextColumn Header="from" Binding="{Binding FromNodeId}" Width="160"/>
          <DataGridTextColumn Header="to" Binding="{Binding ToNodeId}" Width="160"/>
          <DataGridTextColumn Header="kind" Binding="{Binding Kind}" Width="90"/>
          <DataGridTextColumn Header="cost" Binding="{Binding TravelCost}" Width="60"/>
          <DataGridTextColumn Header="danger" Binding="{Binding Danger}" Width="70"/>
          <DataGridTextColumn Header="state" Binding="{Binding State}" Width="80"/>
          <DataGridCheckBoxColumn Header="单向" Binding="{Binding Directed}" Width="50"/>
          <DataGridTextColumn Header="通行条件（kind:id，逗号）" Binding="{Binding TraversalRequirements}" Width="220"/>
          <DataGridTextColumn Header="encounterPoolId" Binding="{Binding EncounterPoolId}" Width="140"/>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </DockPanel>
</Window>

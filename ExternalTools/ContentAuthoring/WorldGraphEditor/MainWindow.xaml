<Window x:Class="WorldGraphEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XianXia · WorldGraphEditor — Hex World" Height="920" Width="1440"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Editor.Background}"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
        <Button Content="新建" Width="56" Margin="0,0,6,0" Click="NewWorld_Click"/>
        <Button Content="打开…" Width="64" Margin="0,0,6,0" Click="Open_Click"/>
        <Button Content="保存" Width="56" Margin="0,0,6,0" Click="Save_Click"/>
        <Button Content="另存为…" Width="72" Margin="0,0,12,0" Click="SaveAs_Click"/>
        <Button Content="校验" Width="56" Margin="0,0,6,0" Click="Validate_Click"/>
        <Button Content="适应" Width="56" Margin="0,0,6,0" Click="Fit_Click"/>
        <Button Content="撤销" Width="56" Margin="0,0,6,0" Click="Undo_Click"/>
        <Button Content="重做" Width="56" Margin="0,0,12,0" Click="Redo_Click"/>
        <TextBlock x:Name="PathText" Foreground="{StaticResource Editor.TextMuted}" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Foreground="{StaticResource Editor.TextMuted}" FontSize="12"
                 Text="Hex 战略大地图编辑器 · 中键/Alt+拖 平移 · 滚轮缩放 · 左键绘制 · Ctrl+Z/Y 撤销重做"/>
    </StackPanel>

    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="{StaticResource Editor.TextMuted}"/>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="300"/>
      </Grid.ColumnDefinitions>

      <TabControl x:Name="SidebarTabs" Grid.Column="0" SelectionChanged="SidebarTabs_SelectionChanged">
        <TabItem Header="地图编辑">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
          <TextBlock Text="地图工具" FontWeight="SemiBold" Foreground="{StaticResource Editor.Text}" Margin="0,0,0,6"/>
          <ToggleButton x:Name="ToolSelect" Content="选择" IsChecked="True" Click="ToolChanged"/>
          <ToggleButton x:Name="ToolTerrain" Content="地形" Click="ToolChanged"/>
          <ToggleButton x:Name="ToolRoad" Content="道路" Click="ToolChanged"/>
          <ToggleButton x:Name="ToolSite" Content="地点 / WorldSite" Click="ToolChanged"/>
          <ToggleButton x:Name="ToolErase" Content="擦除" Click="ToolChanged"/>
          <Border x:Name="SiteToolPanel" Background="{StaticResource Editor.Panel}" BorderBrush="{StaticResource Editor.Border}" BorderThickness="1" Padding="7" Margin="0,8,0,0" Visibility="Collapsed">
            <StackPanel><TextBlock Text="WorldSite" Foreground="{StaticResource Editor.Text}" FontWeight="SemiBold"/><Button Content="＋ 新建 WorldSite" Margin="0,6,0,0" Click="ArmNewSite_Click"/><TextBlock Text="地点类型" Foreground="{StaticResource Editor.TextMuted}" Margin="0,7,0,3"/><ComboBox x:Name="SiteTypeCombo" SelectedIndex="0" SelectionChanged="SiteType_Changed"><ComboBoxItem Content="Village"/><ComboBoxItem Content="Town"/><ComboBoxItem Content="Pass"/><ComboBoxItem Content="Mine"/><ComboBoxItem Content="Forest"/><ComboBoxItem Content="Sect"/><ComboBoxItem Content="Ferry"/></ComboBox><TextBlock Text="点击已有 WorldSite 可选中并编辑。新建需先按上方按钮。" Foreground="{StaticResource Editor.TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
          </Border>
          <TextBlock Text="笔刷半径" Foreground="{StaticResource Editor.TextMuted}" Margin="0,10,0,4"/>
          <ComboBox x:Name="BrushRadiusCombo" SelectedIndex="0" SelectionChanged="BrushRadius_Changed">
            <ComboBoxItem Content="1 格"/>
            <ComboBoxItem Content="2 格"/>
            <ComboBoxItem Content="3 格"/>
            <ComboBoxItem Content="5 格"/>
          </ComboBox>
          <TextBlock Text="地形" Foreground="{StaticResource Editor.TextMuted}" Margin="0,12,0,4"/>
          <ListBox x:Name="TerrainList" Height="130" SelectionChanged="TerrainList_SelectionChanged"/>
        </StackPanel>
      </ScrollViewer>
        </TabItem>
        <TabItem Header="控制资产">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Control Asset 控制资产" FontWeight="SemiBold" Foreground="{StaticResource Editor.Text}" Margin="0,0,0,6"/>
              <TextBlock Text="WorldSite（Footprint+一环）与 FactionFlag（Anchor+一环）是正式真源；重叠时 EstablishedOrder 较小者抢先。" Foreground="{StaticResource Editor.TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <TextBlock Text="搜索势力" Foreground="{StaticResource Editor.TextMuted}" Margin="0,0,0,3"/>
              <TextBox x:Name="TerritorySearchBox" Margin="0,0,0,6" TextChanged="TerritorySearchBox_TextChanged" ToolTip="搜索势力（中文名 / FactionId）"/>
              <Border x:Name="TerritoryBrushPanel" Background="{StaticResource Editor.Panel}" BorderBrush="{StaticResource Editor.Border}" BorderThickness="1" Padding="7" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Text="当前笔刷" Foreground="{StaticResource Editor.TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                  <StackPanel x:Name="TerritoryBrushCurrent" Orientation="Horizontal">
                    <Rectangle x:Name="TerritoryBrushSwatch" Width="16" Height="16" RadiusX="3" RadiusY="3" VerticalAlignment="Center" Fill="#FFB3945C" StrokeThickness="1"/>
                    <StackPanel Margin="8,0,0,0">
                      <TextBlock x:Name="TerritoryBrushName" Text="未选择" FontWeight="SemiBold" Foreground="{StaticResource Editor.Text}"/>
                      <TextBlock x:Name="TerritoryBrushId" Text="—" FontSize="10" Foreground="{StaticResource Editor.TextMuted}"/>
                    </StackPanel>
                  </StackPanel>
                  <TextBlock x:Name="TerritoryBrushInstruction" Foreground="{StaticResource Editor.TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Text="左键 / 左拖：涂当前势力。右键 / 右拖：清除势力。涂到 WorldSite 本体或外围一圈会自动更新整个 Site 辖区。"/>
                </StackPanel>
              </Border>
              <ListBox x:Name="TerritoryList" Height="240" SelectionChanged="TerritoryList_SelectionChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                      <Grid Width="14" Height="14" VerticalAlignment="Center">
                        <Rectangle x:Name="FactionSwatch" RadiusX="3" RadiusY="3" Fill="{Binding Brush}" Stroke="#33000000" StrokeThickness="0.5"/>
                        <TextBlock x:Name="UnownedMarker" Text="□" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Editor.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                      </Grid>
                      <StackPanel Margin="7,0,0,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Editor.Text}"/>
                        <TextBlock Text="{Binding Id}" FontSize="10" Foreground="{StaticResource Editor.TextMuted}"/>
                      </StackPanel>
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsUnowned}" Value="True">
                        <Setter TargetName="FactionSwatch" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="UnownedMarker" Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Border Background="{StaticResource Editor.Panel}" BorderBrush="{StaticResource Editor.Border}" BorderThickness="1" Padding="7" Margin="0,8,0,0">
                <StackPanel>
                  <TextBlock Text="FactionFlag 阵营旗" FontWeight="SemiBold" Foreground="{StaticResource Editor.Text}"/>
                  <TextBlock Text="选择势力 → 点击地图 Hex → 立旗。自动生成唯一 FlagId 与顺序；无需手动维护任何 ID。" Foreground="{StaticResource Editor.TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,6"/>
                  <TextBlock x:Name="FlagLegalityText" Foreground="{StaticResource Editor.WarningText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                  <TextBlock x:Name="FlagAutoIdText" Foreground="{StaticResource Editor.TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button x:Name="CreateFlagButton" Content="在当前 Hex 立旗" IsEnabled="False" Click="CreateFlag_Click"/>
                    <Button Content="删除当前 Hex 旗" Margin="6,0,0,0" Click="DeleteFlag_Click"/>
                  </StackPanel>
                  <Expander Header="高级设置（自定义 FlagId / 顺序 / LocalMap 位置）" IsExpanded="False">
                    <StackPanel Margin="0,6,0,0">
                      <TextBlock Text="FlagId（留空 = 自动 base:flag_q{Q}_r{R}；重复自动加 _2/_3）" Foreground="{StaticResource Editor.TextMuted}" FontSize="11" Margin="0,0,0,3"/>
                      <TextBox x:Name="FlagIdBox" Margin="0,0,0,6" ToolTip="自定义 FlagId；留空自动生成" TextChanged="FlagIdBox_TextChanged"/>
                      <TextBlock Text="EstablishedOrder（留空 = 自动取全局下一顺序）" Foreground="{StaticResource Editor.TextMuted}" FontSize="11" Margin="0,0,0,3"/>
                      <TextBox x:Name="FlagEstablishedOrderBox" Margin="0,0,0,6" ToolTip="EstablishedOrder（留空=自动取全局下一顺序）"/>
                      <CheckBox x:Name="FlagHasLocalPositionBox" Content="指定控制建筑中心位置" Foreground="{StaticResource Editor.Text}" Checked="FlagLocalMode_Changed" Unchecked="FlagLocalMode_Changed"/>
                      <StackPanel x:Name="FlagLocalPanel" Orientation="Horizontal" Margin="0,4,0,0" Visibility="Collapsed">
                        <TextBox x:Name="FlagLocalXBox" Text="0" Width="72" ToolTip="LocalX"/>
                        <TextBox x:Name="FlagLocalZBox" Text="0" Width="72" Margin="5,0,0,0" ToolTip="LocalZ"/>
                      </StackPanel>
                      <TextBlock Text="LocalX/LocalZ 表示 4×4 控制建筑中心。默认 HasLocalPosition=false：Runtime 会避开静态阻挡与 Surface Exit，确定性寻找最近合法落点。" Foreground="{StaticResource Editor.TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Border>
              <TextBlock Text="Legacy/debug：下方旧 Territory 笔刷仅供兼容检查，不再是政治控制真源。" Foreground="{StaticResource Editor.WarningText}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="管理势力…" Width="96" Click="ManageFactions_Click"/>
                <Button Content="验证 Territory" Margin="6,0,0,0" Click="ValidateTerritory_Click"/>
              </StackPanel>
              <TextBlock x:Name="TerritoryHintText" Foreground="{StaticResource Editor.WarningText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="势力管理">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="势力管理" FontWeight="SemiBold" Foreground="{StaticResource Editor.Text}" Margin="0,0,0,6"/>
              <TextBlock Text="编辑正式 factions.json。已有势力 ID 固定不变；名称、地图颜色与领土绘制资格可调整。" Foreground="{StaticResource Editor.TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <Button Content="打开势力管理" Click="ManageFactions_Click"/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="开局战略">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="开局战略" FontWeight="SemiBold" Foreground="{StaticResource Editor.Text}" Margin="0,0,0,6"/>
              <TextBlock Text="配置新游戏开始时的玩家势力、附庸、联盟与战争。运行后的关系变化由存档保存。" Foreground="{StaticResource Editor.TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <Button Content="编辑开局战略" Click="EditOpeningStrategic_Click"/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>

      <Border x:Name="MapHost" Grid.Column="1" Background="{StaticResource Editor.Panel}" BorderBrush="{StaticResource Editor.Border}" BorderThickness="1" ClipToBounds="True"
              SizeChanged="MapHost_SizeChanged"
              PreviewMouseWheel="MapHost_PreviewMouseWheel"
              MouseLeftButtonDown="MapHost_MouseLeftButtonDown"
              MouseRightButtonDown="MapHost_MouseRightButtonDown"
              MouseLeftButtonUp="MapHost_MouseLeftButtonUp"
              MouseMove="MapHost_MouseMove"
              MouseDown="MapHost_MouseDown"
              MouseUp="MapHost_MouseUp"/>

      <GridSplitter Grid.Column="2" Width="8" Background="{StaticResource Editor.Border}"/>

      <ScrollViewer Grid.Column="3" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,0,0,0">
          <TextBlock Text="Hex Inspector" FontWeight="SemiBold" Foreground="{StaticResource Editor.Text}" Margin="0,0,0,8"/>
          <TextBlock x:Name="InspectorText" Foreground="{StaticResource Editor.TextMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <TextBlock Text="Site" FontWeight="SemiBold" Foreground="{StaticResource Editor.Text}" Margin="0,0,0,6"/>
          <TextBlock Text="SiteId" Foreground="{StaticResource Editor.TextMuted}"/>
          <TextBox x:Name="SiteIdBox" Margin="0,0,0,6" LostFocus="SiteFields_LostFocus"/>
          <TextBlock Text="DisplayName" Foreground="{StaticResource Editor.TextMuted}"/>
          <TextBox x:Name="SiteNameBox" Margin="0,0,0,6" LostFocus="SiteFields_LostFocus"/>
          <TextBlock Text="SiteType" Foreground="{StaticResource Editor.TextMuted}"/>
          <TextBox x:Name="SiteTypeBox" Margin="0,0,0,6" LostFocus="SiteFields_LostFocus"/>
          <TextBlock Text="LocalMapId" Foreground="{StaticResource Editor.TextMuted}"/>
          <TextBox x:Name="SiteLocalMapBox" Margin="0,0,0,6" LostFocus="SiteFields_LostFocus"/>
          <TextBlock Text="OwnerFaction" Foreground="{StaticResource Editor.TextMuted}"/>
          <ComboBox x:Name="SiteOwnerCombo" Margin="0,0,0,6" DisplayMemberPath="Name" LostFocus="SiteFields_LostFocus"/>
          <TextBlock Text="ControlEstablishedOrder" Foreground="{StaticResource Editor.TextMuted}"/>
          <TextBox x:Name="SiteEstablishedOrderBox" Margin="0,0,0,6" LostFocus="SiteFields_LostFocus"/>
          <TextBlock x:Name="SiteTerritoryText" Foreground="{StaticResource Editor.TextMuted}" TextWrapping="Wrap" Margin="0,0,0,6"/>
          <TextBlock Text="Footprint" FontWeight="SemiBold" Foreground="{StaticResource Editor.Text}" Margin="0,8,0,6"/>
          <TextBlock x:Name="SiteAnchorText" Foreground="{StaticResource Editor.TextMuted}" TextWrapping="Wrap" Margin="0,0,0,4"/>
          <TextBlock x:Name="SitePresenceText" Foreground="{StaticResource Editor.TextMuted}" TextWrapping="Wrap" Margin="0,0,0,4"/>
          <TextBlock x:Name="SiteFootprintCountText" Foreground="{StaticResource Editor.TextMuted}" Margin="0,0,0,4"/>
          <TextBlock x:Name="SiteFootprintListText" Foreground="{StaticResource Editor.TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
          <ToggleButton x:Name="FootprintModeBox" Content="编辑 Footprint" Margin="0,0,0,6" Checked="FootprintMode_Changed" Unchecked="FootprintMode_Changed"/>
          <Button x:Name="SetAnchorButton" Content="将当前 Hex 设为 Anchor" Margin="0,0,0,6" Click="SetAnchor_Click"/>
          <Button x:Name="SetPresenceButton" Content="将当前 Hex 设为 Presence" Margin="0,0,0,6" Click="SetPresence_Click" Visibility="Collapsed"/>
          <TextBlock x:Name="FootprintEditStatusText" Foreground="{StaticResource Editor.WarningText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <Button Content="删除 WorldSite" Margin="0,0,0,8" Click="DeleteSite_Click" Style="{StaticResource DangerButtonStyle}"/>
          <TextBlock x:Name="ValidationText" Foreground="{StaticResource Editor.WarningText}" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>

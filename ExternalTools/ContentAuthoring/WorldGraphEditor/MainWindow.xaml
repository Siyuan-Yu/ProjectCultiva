<Window x:Class="WorldGraphEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XianXia · WorldGraphEditor — Hex World" Height="920" Width="1440"
        WindowStartupLocation="CenterScreen"
        Background="#16181C"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
        <Button Content="新建" Width="56" Margin="0,0,6,0" Click="NewWorld_Click"/>
        <Button Content="打开…" Width="64" Margin="0,0,6,0" Click="Open_Click"/>
        <Button Content="保存" Width="56" Margin="0,0,6,0" Click="Save_Click"/>
        <Button Content="另存为…" Width="72" Margin="0,0,12,0" Click="SaveAs_Click"/>
        <Button Content="校验" Width="56" Margin="0,0,6,0" Click="Validate_Click"/>
        <Button Content="适应" Width="56" Margin="0,0,6,0" Click="Fit_Click"/>
        <Button Content="撤销" Width="56" Margin="0,0,6,0" Click="Undo_Click"/>
        <Button Content="重做" Width="56" Margin="0,0,12,0" Click="Redo_Click"/>
        <TextBlock x:Name="PathText" Foreground="#C8C4BC" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Foreground="#8A8680" FontSize="12"
                 Text="Hex 战略大地图编辑器 · 中键/Alt+拖 平移 · 滚轮缩放 · 左键绘制 · Ctrl+Z/Y 撤销重做"/>
    </StackPanel>

    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="#A8A49C"/>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="300"/>
      </Grid.ColumnDefinitions>

      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
          <TextBlock Text="工具" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6"/>
          <RadioButton x:Name="ToolSelect" Content="选择" Foreground="White" IsChecked="True" GroupName="Tools" Checked="ToolChanged"/>
          <RadioButton x:Name="ToolTerrain" Content="地形笔刷" Foreground="White" GroupName="Tools" Checked="ToolChanged"/>
          <RadioButton x:Name="ToolRoad" Content="道路" Foreground="White" GroupName="Tools" Checked="ToolChanged"/>
          <RadioButton x:Name="ToolSite" Content="放置地点" Foreground="White" GroupName="Tools" Checked="ToolChanged"/>
          <RadioButton x:Name="ToolErase" Content="擦除" Foreground="White" GroupName="Tools" Checked="ToolChanged"/>
          <TextBlock Text="笔刷半径" Foreground="#8A8680" Margin="0,10,0,4"/>
          <ComboBox x:Name="BrushRadiusCombo" SelectedIndex="0" SelectionChanged="BrushRadius_Changed">
            <ComboBoxItem Content="1 格"/>
            <ComboBoxItem Content="2 格"/>
            <ComboBoxItem Content="3 格"/>
            <ComboBoxItem Content="5 格"/>
          </ComboBox>
          <TextBlock Text="地形" Foreground="#8A8680" Margin="0,12,0,4"/>
          <ListBox x:Name="TerrainList" Height="130" SelectionChanged="TerrainList_SelectionChanged"/>
          <TextBlock Text="地点类型" Foreground="#8A8680" Margin="0,12,0,4"/>
          <ComboBox x:Name="SiteTypeCombo" SelectedIndex="0" SelectionChanged="SiteType_Changed">
            <ComboBoxItem Content="Village"/>
            <ComboBoxItem Content="Town"/>
            <ComboBoxItem Content="Pass"/>
            <ComboBoxItem Content="Mine"/>
            <ComboBoxItem Content="Forest"/>
            <ComboBoxItem Content="Sect"/>
            <ComboBoxItem Content="Ferry"/>
          </ComboBox>
          <CheckBox x:Name="FootprintModeBox" Content="编辑 Footprint" Foreground="#C8C4BC" Margin="0,12,0,0"
                    Checked="FootprintMode_Changed" Unchecked="FootprintMode_Changed"/>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Column="1" Background="#1E2228" BorderBrush="#2A2E34" BorderThickness="1" ClipToBounds="True">
        <Canvas x:Name="MapCanvas"
                Background="#2A2620"
                SizeChanged="MapCanvas_SizeChanged"
                PreviewMouseWheel="MapCanvas_PreviewMouseWheel"
                MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown"
                MouseLeftButtonUp="MapCanvas_MouseLeftButtonUp"
                MouseMove="MapCanvas_MouseMove"
                MouseDown="MapCanvas_MouseDown"
                MouseUp="MapCanvas_MouseUp"/>
      </Border>

      <GridSplitter Grid.Column="2" Width="8" Background="#2A2E34"/>

      <ScrollViewer Grid.Column="3" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,0,0,0">
          <TextBlock Text="Hex Inspector" FontWeight="SemiBold" Foreground="#E8E4DC" Margin="0,0,0,8"/>
          <TextBlock x:Name="InspectorText" Foreground="#C8C4BC" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <TextBlock Text="Site" FontWeight="SemiBold" Foreground="#E8E4DC" Margin="0,0,0,6"/>
          <TextBlock Text="SiteId" Foreground="#8A8680"/>
          <TextBox x:Name="SiteIdBox" Margin="0,0,0,6" LostFocus="SiteFields_LostFocus"/>
          <TextBlock Text="DisplayName" Foreground="#8A8680"/>
          <TextBox x:Name="SiteNameBox" Margin="0,0,0,6" LostFocus="SiteFields_LostFocus"/>
          <TextBlock Text="SiteType" Foreground="#8A8680"/>
          <TextBox x:Name="SiteTypeBox" Margin="0,0,0,6" LostFocus="SiteFields_LostFocus"/>
          <TextBlock Text="LocalMapId" Foreground="#8A8680"/>
          <TextBox x:Name="SiteLocalMapBox" Margin="0,0,0,6" LostFocus="SiteFields_LostFocus"/>
          <Button Content="删除地点" Margin="0,0,0,8" Click="DeleteSite_Click"/>
          <TextBlock x:Name="ValidationText" Foreground="#FFAA66" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>

<Window x:Class="QuestEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XianXia · 任务编辑器" Height="800" Width="1100"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <Button Content="打开包…" Width="90" Margin="0,0,8,0" Click="OpenPackage_Click"/>
      <Button Content="+ 新任务" Width="90" Margin="0,0,8,0" Click="NewQuest_Click"/>
      <Button Content="保存到磁盘" Width="100" Margin="0,0,8,0" Click="Save_Click"/>
      <TextBlock x:Name="RootText" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <GroupBox Header="任务列表" Margin="0,0,8,0">
        <ListBox x:Name="QuestList" SelectionChanged="QuestList_SelectionChanged"/>
      </GroupBox>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <DockPanel Margin="0,0,0,6">
            <TextBlock Text="id" Width="90" VerticalAlignment="Center"/>
            <TextBox x:Name="IdBox"/>
          </DockPanel>
          <DockPanel Margin="0,0,0,6">
            <TextBlock Text="name" Width="90" VerticalAlignment="Center"/>
            <TextBox x:Name="NameBox"/>
          </DockPanel>
          <CheckBox x:Name="AutoOfferBox" Content="autoOffer（条件满足自动接取）" Margin="0,0,0,8"/>
          <TextBlock Text="description"/>
          <TextBox x:Name="DescBox" AcceptsReturn="True" Height="70" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>
          <TextBlock Text="offerConditions（JSON 数组）"/>
          <TextBox x:Name="OfferBox" AcceptsReturn="True" Height="90" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>
          <TextBlock Text="completeConditions（JSON 数组）"/>
          <TextBox x:Name="CompleteBox" AcceptsReturn="True" Height="90" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>
          <TextBlock Text="rewards（JSON 数组）"/>
          <TextBox x:Name="RewardsBox" AcceptsReturn="True" Height="90" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>
          <TextBlock Text="failConditions（JSON 数组）"/>
          <TextBox x:Name="FailCondBox" AcceptsReturn="True" Height="70" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>
          <TextBlock Text="failResults（JSON 数组）"/>
          <TextBox x:Name="FailResBox" AcceptsReturn="True" Height="70" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>

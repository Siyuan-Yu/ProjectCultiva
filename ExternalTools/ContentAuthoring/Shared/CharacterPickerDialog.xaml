<Window x:Class="ContentAuthoring.Shared.CharacterPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择人物" Width="720" Height="560" MinWidth="580" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="按中文名或 Definition ID 搜索" FontWeight="SemiBold"/>
    <TextBox x:Name="SearchBox" Grid.Row="1" Height="31" Margin="0,7,0,10"
             VerticalContentAlignment="Center" TextChanged="Filter_Changed"
             ToolTip="搜索中文名或 Definition ID"/>
    <ListBox x:Name="ResultList" Grid.Row="2" BorderBrush="#C9CDD4" BorderThickness="1"
             MouseDoubleClick="ResultList_MouseDoubleClick">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="7,5">
            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Name}"/>
            <TextBlock Foreground="#4E5865" Text="{Binding Id}"/>
            <TextBlock Foreground="#7B8490" FontSize="11">
              <Run Text="来源："/><Run Text="{Binding SourceRelativePath}"/>
            </TextBlock>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="CountText" Grid.Row="3" Foreground="#667080" Margin="2,7,0,0"/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="取消" MinWidth="82" Padding="10,5" IsCancel="True"/>
      <Button Content="确定" MinWidth="82" Padding="10,5" Margin="8,0,0,0" IsDefault="True" Click="Accept_Click"/>
    </StackPanel>
  </Grid>
</Window>

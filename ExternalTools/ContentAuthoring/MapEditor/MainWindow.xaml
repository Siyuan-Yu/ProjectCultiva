<Window x:Class="MapEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XianXia · MapEditor" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        Focusable="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
        <Button Content="打开包…" Width="90" Margin="0,0,8,0" Click="OpenPackage_Click"/>
        <TextBlock Text="地图" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox x:Name="MapCombo" Width="280" SelectionChanged="MapCombo_SelectionChanged"/>
        <Button Content="打开地图…" Width="80" Margin="8,0,0,0" Click="OpenMapFile_Click" ToolTip="从 Content/BaseGame/Data 打开 mapLayout JSON"/>
        <Button Content="新建空图" Width="80" Margin="8,0,0,0" Click="NewFromTemplate_Click" ToolTip="在 Content/Data 新建空地图"/>
        <Button Content="保存 Ctrl+S" Width="100" Margin="8,0,0,0" Click="Save_Click"/>
        <Button Content="另存为…" Width="70" Margin="8,0,0,0" Click="SaveAs_Click" ToolTip="另存到 Content/BaseGame/Data"/>
        <Separator Margin="10,0" Width="1" Background="#C0B8A8"/>
        <Button Content="撤销" Width="50" Margin="0,0,4,0" Click="Undo_Click" ToolTip="Ctrl+Z"/>
        <Button Content="重做" Width="50" Margin="0,0,4,0" Click="Redo_Click" ToolTip="Ctrl+Y"/>
        <Button Content="复制" Width="50" Margin="0,0,4,0" Click="Duplicate_Click" ToolTip="Ctrl+D"/>
        <Button Content="删除" Width="50" Margin="0,0,8,0" Click="DeleteSelected_Click" ToolTip="Delete"/>
        <TextBlock Text="缩放" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <Button Content="－" Width="32" Margin="0,0,2,0" Click="ZoomOut_Click" ToolTip="缩小"/>
        <Slider x:Name="ZoomSlider" Width="120" Minimum="25" Maximum="400" Value="100"
                VerticalAlignment="Center" TickFrequency="25" IsSnapToTickEnabled="False"
                ValueChanged="ZoomSlider_ValueChanged" ToolTip="拖动缩放"/>
        <Button Content="＋" Width="32" Margin="2,0,4,0" Click="ZoomIn_Click" ToolTip="放大"/>
        <TextBlock x:Name="ZoomLabel" Text="100%" Width="44" VerticalAlignment="Center"/>
        <Button Content="100%" Width="50" Margin="0,0,4,0" Click="ZoomReset_Click" ToolTip="Ctrl+0"/>
        <Button Content="适应" Width="50" Click="ZoomFit_Click" ToolTip="Ctrl+1 适应窗口"/>
        <TextBlock x:Name="RootText" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </StackPanel>
      <Border BorderBrush="#C0B8A8" BorderThickness="1" Padding="8" Background="#FFFDF8" Margin="0,0,0,6">
        <StackPanel>
          <TextBlock Text="整图尺寸（格数）— 改完点「应用地图尺寸」或回车" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="宽" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="WidthBox" Width="70" Margin="0,0,10,0" KeyDown="MapSize_KeyDown"/>
            <TextBlock Text="高" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="HeightBox" Width="70" Margin="0,0,10,0" KeyDown="MapSize_KeyDown"/>
            <TextBlock Text="originX" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="OriginXBox" Width="70" Margin="0,0,8,0"/>
            <TextBlock Text="originY" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="OriginYBox" Width="70" Margin="0,0,8,0"/>
            <TextBlock Text="cellSize" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="CellSizeBox" Width="50" Margin="0,0,10,0"/>
            <Button Content="应用地图尺寸" Width="110" Margin="0,0,8,0" Click="ResizeMap_Click"/>
            <Button Content="80×50" Width="60" Margin="0,0,4,0" Click="PresetSize_Click" Tag="80,50"/>
            <Button Content="200×100" Width="70" Margin="0,0,4,0" Click="PresetSize_Click" Tag="200,100"/>
            <Button Content="400×200" Width="70" Click="PresetSize_Click" Tag="400,200"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="name" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="NameBox" Width="200" Margin="0,0,10,0"/>
            <TextBlock Text="worldRegionId" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="RegionIdBox" Width="220"/>
            <TextBlock x:Name="SizeHintText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#6B6358"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <TextBlock x:Name="CursorText" DockPanel.Dock="Right" MinWidth="220" TextAlignment="Right" Foreground="#6B6358"/>
      <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                 Text="提示：缩放用顶部滑条／＋－，或 Ctrl+滚轮。中键／空格+拖 自由平移（可拖出地图范围）。"/>
    </DockPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="240"/>
      </Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0" Margin="0,0,8,0">
        <TextBlock DockPanel.Dock="Top" Text="工具板" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#6B6358" Margin="0,0,0,6"
                   Text="第 1 页：地表／物件／建筑。第 2 页：分区标记（无玩法）。右键画布＝选择工具。"/>
        <TabControl x:Name="PaletteTabs">
          <TabItem Header="1 · 物件">
            <ListBox x:Name="PaletteObjectsList" DisplayMemberPath="Display"
                     SelectionChanged="PaletteList_SelectionChanged"/>
          </TabItem>
          <TabItem Header="2 · 分区">
            <ListBox x:Name="PaletteZonesList" DisplayMemberPath="Display"
                     SelectionChanged="PaletteList_SelectionChanged"/>
          </TabItem>
        </TabControl>
      </DockPanel>
      <Border Grid.Column="1" BorderBrush="#C0B8A8" BorderThickness="1" Background="#F3EFE6" ClipToBounds="True">
        <ScrollViewer x:Name="MapScroll" Background="#F3EFE6"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                      Focusable="False"
                      PreviewMouseDown="MapScroll_PreviewMouseDown"
                      PreviewMouseMove="MapScroll_PreviewMouseMove"
                      PreviewMouseUp="MapScroll_PreviewMouseUp"
                      LostMouseCapture="MapScroll_LostMouseCapture"
                      MouseMove="MapScroll_MouseMove">
          <Canvas x:Name="MapCanvas" Focusable="True"
                  PreviewMouseLeftButtonDown="MapCanvas_PreviewMouseLeftButtonDown"
                  PreviewMouseRightButtonDown="MapCanvas_PreviewMouseRightButtonDown"
                  MouseMove="MapCanvas_MouseMove"
                  MouseLeftButtonUp="MapCanvas_MouseLeftButtonUp"/>
        </ScrollViewer>
      </Border>
      <DockPanel Grid.Column="2" Margin="8,0,0,0">
        <TextBlock DockPanel.Dock="Top" Text="已放置" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <TextBlock Text="选中属性" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock Text="id"/>
          <TextBox x:Name="PropId" Margin="0,0,0,4"/>
          <TextBlock Text="label"/>
          <TextBox x:Name="PropLabel" Margin="0,0,0,4"/>
          <TextBlock Text="boundLocationId"/>
          <TextBox x:Name="PropBound" Margin="0,0,0,4"/>
          <TextBlock Text="lootItemId（地上物）"/>
          <TextBox x:Name="PropLootItem" Margin="0,0,0,4"/>
          <TextBlock Text="spawnTableId（刷怪区）"/>
          <TextBox x:Name="PropSpawnTable" Margin="0,0,0,4"/>
          <Button Content="编辑／新建刷怪表…" Margin="0,0,0,4" Click="EditSpawnTable_Click"/>
          <TextBlock Text="spawnCount（0＝按表 countMin～Max）"/>
          <TextBox x:Name="PropSpawnCount" Margin="0,0,0,4"/>
          <CheckBox x:Name="PropBlock" Content="挡路（blocksMovement）— 建筑默认开；树／矿等装饰需手勾" Margin="0,0,0,4"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="X" Width="20" VerticalAlignment="Center"/>
            <TextBox x:Name="PropX" Width="40" Margin="0,0,6,0"/>
            <TextBlock Text="Y" Width="20" VerticalAlignment="Center"/>
            <TextBox x:Name="PropY" Width="40" Margin="0,0,6,0"/>
            <TextBlock Text="W" Width="20" VerticalAlignment="Center"/>
            <TextBox x:Name="PropW" Width="40" Margin="0,0,6,0"/>
            <TextBlock Text="H" Width="20" VerticalAlignment="Center"/>
            <TextBox x:Name="PropH" Width="40"/>
          </StackPanel>
          <Button Content="应用属性" Margin="0,0,0,4" Click="ApplyProps_Click"/>
          <Button Content="删除选中" Click="DeleteSelected_Click"/>
        </StackPanel>
        <ListBox x:Name="PlacementList" DisplayMemberPath="ListText"
                 SelectionChanged="PlacementList_SelectionChanged"/>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>

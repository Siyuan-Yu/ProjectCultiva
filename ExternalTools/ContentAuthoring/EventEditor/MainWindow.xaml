<Window x:Class="EventEditor.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shared="clr-namespace:ContentAuthoring.Shared;assembly=Shared"
 xmlns:local="clr-namespace:EventEditor"
 Title="XianXia · Event Editor" Height="940" Width="1540" MinWidth="1180" MinHeight="720"
 WindowStartupLocation="CenterScreen" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
 <DockPanel Background="#F4F5F7">
  <Border DockPanel.Dock="Top" Background="#20242B" Padding="10,8">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/>
    </Grid.ColumnDefinitions>
    <Button Content="打开包…" Padding="12,6" Click="OpenPackage_Click"/>
    <Button Grid.Column="1" Content="＋ 新建" Padding="12,6" Margin="7,0,0,0" Click="NewEvent_Click"/>
    <Button Grid.Column="2" x:Name="SaveButton" Content="保存" Padding="12,6" Margin="7,0,0,0" Click="Save_Click"/>
    <Button Grid.Column="3" x:Name="UndoButton" Content="撤销" Padding="12,6" Margin="14,0,0,0" Click="Undo_Click"/>
    <Button Grid.Column="4" x:Name="RedoButton" Content="重做" Padding="12,6" Margin="7,0,0,0" Click="Redo_Click"/>
    <Button Grid.Column="5" Content="自动整理" Padding="12,6" Margin="14,0,0,0" Click="AutoLayout_Click"/>
    <Button Grid.Column="6" Content="缩放到全部" Padding="12,6" Margin="7,0,0,0" Click="ZoomFit_Click"/>
    <TextBlock Grid.Column="7" x:Name="RootText" Foreground="#B8C0CC" VerticalAlignment="Center" Margin="14,0" TextTrimming="CharacterEllipsis"/>
    <TextBox Grid.Column="8" x:Name="SearchBox" Height="30" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="搜索名称、话题、ID、人物、物体或触发时机"/>
   </Grid>
  </Border>
  <StatusBar DockPanel.Dock="Bottom" Background="#E7E9ED"><TextBlock x:Name="StatusText" Text="准备就绪"/></StatusBar>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="White" BorderBrush="#D5D8DE" BorderThickness="0,0,1,0">
    <DockPanel Margin="10">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="内容浏览" FontSize="17" FontWeight="SemiBold" Margin="2,2,0,9"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
       <RadioButton x:Name="ByObjectRadio" Content="按对象" IsChecked="True" GroupName="BrowserMode" Checked="BrowserMode_Changed" Margin="3,0,18,0"/>
       <RadioButton x:Name="ByEventRadio" Content="按事件" GroupName="BrowserMode" Checked="BrowserMode_Changed"/>
      </StackPanel>
     </StackPanel>
     <TreeView x:Name="BrowserTree" SelectedItemChanged="BrowserTree_SelectedItemChanged" BorderThickness="0"/>
    </DockPanel>
   </Border>
   <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#DDE0E5"/>
   <Grid Grid.Column="2" Background="#1D2026">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#2B3038" Padding="12,9" BorderBrush="#3A414C" BorderThickness="0,0,0,1">
     <DockPanel>
      <Button DockPanel.Dock="Right" Content="编辑事件设置" Padding="10,4" Click="ShowEventInspector_Click"/>
      <StackPanel><TextBlock x:Name="GraphTitleText" Foreground="White" FontSize="16" FontWeight="SemiBold" Text="请选择事件"/><TextBlock x:Name="GraphSummaryText" Foreground="#B8C0CC" Margin="0,3,0,0"/></StackPanel>
     </DockPanel>
    </Border>
    <Grid Grid.Row="1">
     <local:EventFlowGraph x:Name="FlowGraph"/>
     <Border x:Name="EmptyGraphHint" Background="#CC252A31" CornerRadius="7" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
      <StackPanel><TextBlock Text="这个事件还没有对话步骤" Foreground="White" FontSize="17" HorizontalAlignment="Center"/><Button Content="＋ 创建入口步骤" Padding="14,7" Margin="0,12,0,0" Click="AddEntryStep_Click"/></StackPanel>
     </Border>
     <Border x:Name="LegacyBanner" Background="#F9E5A9" BorderBrush="#D2A63B" BorderThickness="1" Padding="14" Margin="16" VerticalAlignment="Top" Visibility="Collapsed">
      <DockPanel><Button DockPanel.Dock="Right" Content="转换为当前格式" Padding="12,5" Click="ConvertLegacy_Click"/><TextBlock Text="旧版事件格式：可读取，但不再提供旧 body/choices 编辑。转换后将使用统一 Steps Graph。" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
     </Border>
    </Grid>
    <Expander Grid.Row="2" x:Name="ErrorExpander" Header="验证问题" Background="#F7ECEC" IsExpanded="False"><ListBox x:Name="ErrorList" MaxHeight="150" MouseDoubleClick="ErrorList_MouseDoubleClick" DisplayMemberPath="Display"/></Expander>
   </Grid>
   <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="#DDE0E5"/>
   <Border Grid.Column="4" Background="White" BorderBrush="#D5D8DE" BorderThickness="1,0,0,0">
    <DockPanel>
     <Border DockPanel.Dock="Top" Background="#F7F8FA" Padding="12,10" BorderBrush="#D5D8DE" BorderThickness="0,0,0,1"><TextBlock x:Name="InspectorTitle" Text="Inspector" FontSize="17" FontWeight="SemiBold"/></Border>
     <ScrollViewer VerticalScrollBarVisibility="Auto" LostKeyboardFocus="Inspector_LostKeyboardFocus">
      <StackPanel Margin="14">
       <TextBlock x:Name="InspectorHint" Text="在左侧选择事件，或在 Graph 选择 Step / Choice。" Foreground="#667080" TextWrapping="Wrap"/>
       <StackPanel x:Name="EventInspector" Visibility="Collapsed">
        <TextBlock Text="名称" FontWeight="SemiBold"/><TextBox x:Name="EventNameBox" Margin="0,4,0,10"/>
        <TextBlock Text="话题文字" FontWeight="SemiBold"/><TextBox x:Name="EventTopicBox" Margin="0,4,0,10"/>
        <TextBlock Text="触发时机" FontWeight="SemiBold"/><ComboBox x:Name="EventTriggerBox" Margin="0,4,0,10" SelectionChanged="EventTriggerBox_SelectionChanged"/>
        <GroupBox Header="适用对象 / 互动绑定" Margin="0,0,0,10"><StackPanel Margin="8">
          <StackPanel x:Name="NpcBindingPanel"><TextBlock Text="互动人物"/><ComboBox x:Name="NpcDefBox" IsEditable="True" Margin="0,4,0,8"/></StackPanel>
          <StackPanel x:Name="ObjectBindingPanel"><TextBlock Text="世界物体类型"/><ComboBox x:Name="WorldObjectKindBox" Margin="0,4,0,8" SelectionChanged="WorldObjectKindBox_SelectionChanged"/><TextBlock Text="世界物体实例"/><ComboBox x:Name="WorldObjectIdBox" IsEditable="True" Margin="0,4,0,8"/></StackPanel>
        </StackPanel></GroupBox>
        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="优先级" FontWeight="SemiBold"/><TextBox x:Name="PriorityBox" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="重复规则" FontWeight="SemiBold"/><ComboBox x:Name="RepeatBox" Margin="0,4,0,0"/></StackPanel></Grid>
        <GroupBox Header="事件条件" Margin="0,0,0,10"><shared:JsonArrayEditor x:Name="EventConditionEditor" Margin="8"/></GroupBox>
        <Expander Header="高级设置" Margin="0,4,0,10"><StackPanel Margin="8"><TextBlock Text="Event ID"/><TextBox x:Name="EventIdBox" IsReadOnly="True" Foreground="#666" Margin="0,4,0,8"/><TextBlock Text="地点 ID"/><ComboBox x:Name="LocationBox" IsEditable="True" Margin="0,4,0,8"/><TextBlock Text="任务 ID"/><TextBox x:Name="QuestIdBox" Margin="0,4,0,8"/><TextBlock Text="Graph layout metadata"/><TextBlock x:Name="LayoutPathText" Foreground="#666" TextWrapping="Wrap"/></StackPanel></Expander>
       </StackPanel>
       <StackPanel x:Name="StepInspector" Visibility="Collapsed">
        <TextBlock Text="说话人" FontWeight="SemiBold"/><ComboBox x:Name="SpeakerBox" Margin="0,4,0,8" SelectionChanged="SpeakerBox_SelectionChanged"/><ComboBox x:Name="SpeakerDefBox" IsEditable="True" Margin="0,0,0,10"/>
        <TextBlock Text="正文" FontWeight="SemiBold"/><TextBox x:Name="StepTextBox" AcceptsReturn="True" MinHeight="150" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,4,0,10"/>
        <GroupBox Header="Step Outcomes"><shared:JsonArrayEditor x:Name="StepOutcomeEditor" Margin="8"/></GroupBox>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="设为入口" Padding="10,5" Click="SetEntry_Click"/><Button Content="＋ 添加 Choice" Padding="10,5" Margin="8,0,0,0" Click="AddChoice_Click"/></StackPanel>
        <Expander Header="高级：技术信息" Margin="0,12,0,0"><TextBox x:Name="StepIdText" IsReadOnly="True" Foreground="#666" Margin="8"/></Expander>
       </StackPanel>
       <StackPanel x:Name="ChoiceInspector" Visibility="Collapsed">
        <TextBlock Text="选项文字" FontWeight="SemiBold"/><TextBox x:Name="ChoiceTextBox" Margin="0,4,0,10"/>
        <GroupBox Header="Conditions" Margin="0,0,0,10"><shared:JsonArrayEditor x:Name="ChoiceConditionEditor" Margin="8"/></GroupBox>
        <TextBlock Text="条件不满足时" FontWeight="SemiBold"/><ComboBox x:Name="UnavailableBox" Margin="0,4,0,10"/>
        <TextBlock Text="RequirementText / 条件说明" FontWeight="SemiBold"/><TextBox x:Name="RequirementBox" TextWrapping="Wrap" Margin="0,4,0,10"/>
        <GroupBox Header="Outcomes"><shared:JsonArrayEditor x:Name="ChoiceOutcomeEditor" Margin="8"/></GroupBox>
        <Button Content="删除 Choice" HorizontalAlignment="Left" Padding="10,5" Margin="0,12,0,0" Click="DeleteChoice_Click"/>
        <Expander Header="高级：技术信息" Margin="0,12,0,0"><TextBox x:Name="ChoiceIdText" IsReadOnly="True" Foreground="#666" Margin="8"/></Expander>
       </StackPanel>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
 </DockPanel>
</Window>

<Window x:Class="ManualArtEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XianXia · 功法／斗技编辑器" Height="860" Width="1280"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#444"
                 Text="编辑 cultivation／combatArt：基础字段＋熟练档绝对值（tiers）＋突破材料（breakthroughs）。不连乘。保存写回 Content JSON。"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
        <Button Content="打开包…" Width="90" Margin="0,0,8,0" Click="OpenPackage_Click"/>
        <Button Content="保存当前" Width="90" Margin="0,0,8,0" Click="Save_Click"/>
        <Button Content="新建功法" Width="90" Margin="0,0,8,0" Click="NewManual_Click"/>
        <Button Content="新建斗技" Width="90" Margin="0,0,8,0" Click="NewArt_Click"/>
        <TextBlock x:Name="RootText" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </StackPanel>
    </StackPanel>
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0" Margin="0,0,8,0">
        <TabControl x:Name="KindTabs" DockPanel.Dock="Top" Height="32"
                    SelectionChanged="KindTabs_SelectionChanged">
          <TabItem Header="功法"/>
          <TabItem Header="斗技"/>
        </TabControl>
        <ListBox x:Name="IdList" SelectionChanged="IdList_SelectionChanged"/>
      </DockPanel>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock FontWeight="Bold" Margin="0,0,0,6" Text="基础"/>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="id" VerticalAlignment="Center"/>
            <TextBox x:Name="IdBox" Grid.Column="1" Margin="0,2,8,2" IsReadOnly="True"/>
            <TextBlock Grid.Column="2" Text="name" VerticalAlignment="Center"/>
            <TextBox x:Name="NameBox" Grid.Column="3" Margin="0,2,0,2"/>

            <TextBlock Grid.Row="1" Text="grade" VerticalAlignment="Center"/>
            <TextBox x:Name="GradeBox" Grid.Row="1" Grid.Column="1" Margin="0,2,8,2"/>
            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="RealmLabel" Text="requiredRealm" VerticalAlignment="Center"/>
            <TextBox x:Name="RealmBox" Grid.Row="1" Grid.Column="3" Margin="0,2,0,2"/>

            <TextBlock Grid.Row="2" Text="effectSummary" VerticalAlignment="Center"/>
            <TextBox x:Name="SummaryBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2,0,2"
                     Height="40" TextWrapping="Wrap" AcceptsReturn="True"/>

            <!-- 功法字段 -->
            <TextBlock Grid.Row="3" x:Name="SpeedLabel" Text="cultivationSpeed" VerticalAlignment="Center"/>
            <TextBox x:Name="SpeedBox" Grid.Row="3" Grid.Column="1" Margin="0,2,8,2"/>
            <TextBlock Grid.Row="3" Grid.Column="2" x:Name="BreakLabel" Text="breakthroughProgress" VerticalAlignment="Center"/>
            <TextBox x:Name="BreakBox" Grid.Row="3" Grid.Column="3" Margin="0,2,0,2"/>

            <!-- 斗技字段 -->
            <TextBlock Grid.Row="4" x:Name="DmgLabel" Text="damageAttackMult" VerticalAlignment="Center"/>
            <TextBox x:Name="DmgBox" Grid.Row="4" Grid.Column="1" Margin="0,2,8,2"/>
            <TextBlock Grid.Row="4" Grid.Column="2" x:Name="HitLabel" Text="hitCount" VerticalAlignment="Center"/>
            <TextBox x:Name="HitBox" Grid.Row="4" Grid.Column="3" Margin="0,2,0,2"/>

            <TextBlock Grid.Row="5" x:Name="BonusLabel" Text="attackBonusPercent" VerticalAlignment="Center"/>
            <TextBox x:Name="BonusBox" Grid.Row="5" Grid.Column="1" Margin="0,2,8,2"/>
            <TextBlock Grid.Row="5" Grid.Column="2" x:Name="CdLabel" Text="cooldownSeconds" VerticalAlignment="Center"/>
            <TextBox x:Name="CdBox" Grid.Row="5" Grid.Column="3" Margin="0,2,0,2"/>
          </Grid>

          <TextBlock FontWeight="Bold" Margin="0,8,0,4"
                     Text="熟练档（绝对值；功法填 cultivationSpeed，斗技填 damageAttackMult／attackBonusPercent）"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="+ 档" Width="70" Margin="0,0,8,0" Click="AddTier_Click"/>
            <Button Content="删选中档" Width="90" Click="DeleteTier_Click"/>
          </StackPanel>
          <DataGrid x:Name="TierGrid" Height="180" AutoGenerateColumns="False" CanUserAddRows="False"
                    HeadersVisibility="Column" SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridTextColumn Header="tier" Binding="{Binding Tier}" Width="100"/>
              <DataGridTextColumn Header="cultivationSpeed" Binding="{Binding CultivationSpeed}" Width="120"/>
              <DataGridTextColumn Header="damageAttackMult" Binding="{Binding DamageAttackMult}" Width="130"/>
              <DataGridTextColumn Header="attackBonusPercent" Binding="{Binding AttackBonusPercent}" Width="140"/>
              <DataGridTextColumn Header="damageFlat" Binding="{Binding DamageFlat}" Width="90"/>
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock FontWeight="Bold" Margin="0,12,0,4" Text="突破（from→to；costs 格式 itemId×count，多项用逗号）"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="+ 突破" Width="70" Margin="0,0,8,0" Click="AddBreak_Click"/>
            <Button Content="删选中突破" Width="100" Click="DeleteBreak_Click"/>
          </StackPanel>
          <DataGrid x:Name="BreakGrid" Height="160" AutoGenerateColumns="False" CanUserAddRows="False"
                    HeadersVisibility="Column" SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridTextColumn Header="from" Binding="{Binding From}" Width="90"/>
              <DataGridTextColumn Header="to" Binding="{Binding To}" Width="90"/>
              <DataGridTextColumn Header="progressRequired" Binding="{Binding ProgressRequired}" Width="120"/>
              <DataGridTextColumn Header="costs" Binding="{Binding CostsText}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
